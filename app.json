{
  "expo": {
    "name": "DigiSignHK",
    "slug": "digisignhk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digisignhk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.abigail.digisignhk",
      "infoPlist": {
        "NSCameraUsageDescription": "DigiSignHK needs camera access to recognize hand signs in real time."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abigail.digisignhk",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DigiSignHK needs camera access to recognize hand signs in real time.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-vision-camera-v4-mediapipe/plugin",
        {
          "numHands": 2,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5,
          "enableFace": false
        }
      ],
      "./plugins/with-ios-hand-landmarker",
      "./plugins/with-android-hand-landmarker-performance",
      "./plugins/with-onnxruntime-android-fixes",
      "./plugins/with-android-cmake-windows-fix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc7b0eb2-0831-4302-a8f0-f1cbc68abbe7"
      }
    },
    "owner": "sign-language-org"
  }
}
