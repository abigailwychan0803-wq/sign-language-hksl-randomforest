{
  "expo": {
    "name": "DigiSignHK",
    "slug": "digisignhk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/AppIcon.appiconset/Icon-App-1024x1024@1x.png",
    "scheme": "digisignhk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abigail.digisignhk",
      "infoPlist": {
        "NSCameraUsageDescription": "DigiSignHK needs camera access to recognize hand signs in real time."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/android/playstore/appicononline.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abigail.digisignhk",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/AppIcons/web/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/AppIcons/AppIcon.appiconset/Icon-App-1024x1024@1x.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DigiSignHK needs camera access to recognize hand signs in real time.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-vision-camera-v4-mediapipe/plugin",
        {
          "numHands": 2,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5,
          "enableFace": true
        }
      ],
      "./plugins/with-ios-hand-landmarker",
      "./plugins/with-android-hand-landmarker-performance",
      "./plugins/with-android-vision-camera-devices",
      "./plugins/with-onnxruntime-android-fixes",
      "./plugins/with-android-cmake-windows-fix",
      "expo-video",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "./plugins/with-android-mediapipe-abi"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc7b0eb2-0831-4302-a8f0-f1cbc68abbe7"
      }
    },
    "owner": "sign-language-org"
  }
}
